name: Compiler les plugins TaLaVie
on:
  push:
  workflow_dispatch:
jobs:
  build:
    runs-on: windows-latest
    strategy:
      fail-fast: false
      matrix:
        plugin: [TaLaVie-Guitare, TaLaVie-808, TaLaVie-Pads]
    steps:
      - uses: actions/checkout@v4
      - name: Dezipper les sources
        shell: pwsh
        run: Expand-Archive -Path TaLaVie-Plugins-GitHub.zip -DestinationPath src
      - name: Configurer
        run: cmake -S src/TaLaVie-Plugins/${{ matrix.plugin }} -B build -G "Visual Studio 17 2022" -A x64
      - name: Compiler
        run: cmake --build build --config Release
      - uses: actions/upload-artifact@v4
        with:
          name: ${{ matrix.plugin }}-VST3
          path: build/*_artefacts/Release/VST3/
